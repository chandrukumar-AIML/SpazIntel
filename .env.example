# Project Atlas — Environment Variables
# Copy this to .env and fill in values. Never commit .env.

# --- LLM (at least one required) ---
# Primary: Claude (best quality)
ANTHROPIC_API_KEY=your_key_here
# Fallback: Groq free tier — get key at console.groq.com
GROQ_API_KEY=your_key_here

# --- Tool Paths ---
COLMAP_EXE=C:/path/to/colmap.exe
MODELS_DIR=C:/Users/kumar/spazintel/models
# DUSt3R: git clone --recursive https://github.com/naver/dust3r to this path
DUST3R_DIR=C:/Users/kumar/models/dust3r

# --- Data ---
DATA_DIR=C:/Users/kumar/spazintel/data
SCANS_DIR=C:/Users/kumar/spazintel/data/scans

# --- App ---
DEMO_MODE=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- Sprint 1: 3D Pipeline flags (set to true to skip for faster testing) ---
SKIP_DEPTH=false
SKIP_COLMAP=false
SKIP_SPLAT=false
SPLAT_STEPS=3000

# --- Database ---
DB_PATH=C:/Users/kumar/spazintel/data/atlas.db
