# Project Atlas — Environment Variables
# Copy this to .env and fill in values. Never commit .env.

# --- LLM Fallback Chain (Claude → Groq → Gemini → OpenAI → Ollama) ---
# Primary: Claude (best spatial reasoning) — get key at console.anthropic.com
ANTHROPIC_API_KEY=your_key_here
# Fallback 1: Groq free tier — get key at console.groq.com
GROQ_API_KEY=your_key_here
# Fallback 2: Gemini — get key at aistudio.google.com
GEMINI_API_KEY=your_key_here
# Fallback 3: OpenAI — get key at platform.openai.com
OPENAI_API_KEY=your_key_here
# Fallback 4: Ollama (local, no API key) — install from ollama.com, run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Tool Paths ---
COLMAP_EXE=C:/path/to/colmap.exe
MODELS_DIR=C:/Users/kumar/spazintel/models
# DUSt3R: git clone --recursive https://github.com/naver/dust3r to this path
DUST3R_DIR=C:/Users/kumar/models/dust3r

# --- Data ---
DATA_DIR=C:/Users/kumar/spazintel/data
SCANS_DIR=C:/Users/kumar/spazintel/data/scans

# --- App ---
DEMO_MODE=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Set to your Vercel frontend URL in production. Leave blank for local dev (defaults to *)
# CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=

# --- Camera & Depth Configuration ---
# Camera vertical FOV in degrees. Set this to match your recording device:
#   iPhone 13/14/15 wide lens: ~77°
#   Android varies: 60-80° (check your camera specs)
#   Webcam: ~55-60°
# A wrong FOV shifts all world X/Y coordinates and affects distance accuracy.
VFOV_DEG=75.0
# Approximate room/space depth in metres (far-plane scale for monocular depth).
# Override to match your actual space — e.g. 10.0 for a factory floor, 4.0 for a small room.
# TODO: use COLMAP calibrated focal_length_x/y for metric accuracy when available
ROOM_DEPTH_METRES=5.0

# --- Pipeline Feature Flags (set to true to skip for faster testing) ---
SKIP_DEPTH=false
SKIP_COLMAP=false
SKIP_SPLAT=false
SPLAT_STEPS=3000

# --- Database (not yet implemented — reserved for Phase 3) ---
DB_PATH=C:/Users/kumar/spazintel/data/atlas.db
